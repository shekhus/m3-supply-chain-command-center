# Copy to .env for local runs. Secrets live here only; .env is gitignored and never in the image.

# --- Database ---------------------------------------------------------------
# docker-compose publishes Postgres on 5433 so this stack can run beside m3-trusted-data-foundation.
DATABASE_URL=postgresql+psycopg://m3:m3@localhost:5433/m3cc
POSTGRES_USER=m3
POSTGRES_PASSWORD=m3
POSTGRES_DB=m3cc

# --- Auth (server-side roles) ------------------------------------------------
# Comma-separated role:key pairs. Roles: viewer, analyst, owner. Only an owner approves an action.
API_KEYS=viewer:change-me-viewer,analyst:change-me-analyst,owner:change-me-owner
# Which brief each key sees. The audience is decided by the key, never by the request, so a plant manager's
# key returns a plant manager's brief whatever the URL asks for. Keys not listed here default to 'vp'.
API_AUDIENCES=change-me-owner:vp,change-me-analyst:vp,change-me-viewer:vp
# Where the daily metrics are read from: postgres (after `make metrics`) or parquet (standalone demo).
METRICS_SOURCE=postgres
# The console authenticates to the API like anything else; give it a key from API_KEYS above.
CONSOLE_API_KEY=change-me-owner

# --- Gold source --------------------------------------------------------------
# standalone: this repo generates gold with seeded anomalies (make synth-gold).
# external:   gold comes from m3-trusted-data-foundation; nothing here writes to it either way.
GOLD_SOURCE=standalone
DATA_DIR=data

# --- LLM (narration only; never calculation) ---------------------------------
# LLM_PROVIDER=anthropic | groq | none. With none, briefs use the templated fallback.
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# USD per million tokens, used for ops.llm_calls.cost_usd. Check current pricing before relying on it.
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0

# --- Actions ------------------------------------------------------------------
# JIRA_MODE=mock writes to ops.mock_jira; live needs the Jira env below. Nothing ever posts to M3.
JIRA_MODE=mock
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- Delivery -----------------------------------------------------------------
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
BRIEF_RECIPIENTS=

# --- Console ------------------------------------------------------------------
API_BASE_URL=http://localhost:8010
CONSOLE_URL=http://localhost:8511

# --- Container (scripts/start.sh) --------------------------------------------
# APP_ROLE=api (default) runs migrations then the API; APP_ROLE=console runs the Streamlit console.
# PORT is set by the platform or defaults to 8000/8501. HOST empty = all interfaces (IPv4 + IPv6).
# APP_ROLE=api
# PORT=8000
# HOST=

# --- Policy -------------------------------------------------------------------
POLICY_FILE=policy.yaml
